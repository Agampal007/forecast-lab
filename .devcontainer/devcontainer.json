{
  "name": "forecast-lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev,plots]'",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "forecastlab API", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.testing.pytestArgs": ["tests"], "python.testing.pytestEnabled": true }
    }
  }
}
